{
  "name": "promptforge",
  "private": true,
  "version": "0.1.0",
  "description": "Turn rough text into model-aware, well-engineered prompts \u2014 in the browser, on the desktop and in VS Code.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run typecheck",
    "pf": "node apps/cli/dist/index.js",
    "clean": "rm -rf node_modules packages/*/dist packages/*/node_modules apps/*/dist apps/*/node_modules .turbo",
    "eval": "pnpm --filter @promptforge/evals eval",
    "ship": "bash scripts/ship.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
